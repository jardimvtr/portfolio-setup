createOrReplace

    ref table Fact_Region

        measure Regions = DISTINCTCOUNT('Fact_Region'[region_id])
            formatString: "0"
            displayFolder: "Core"

        measure Countries = DISTINCTCOUNT('Fact_Region'[code])
            formatString: "0"
            displayFolder: "Core"

        measure 'Fuzzy transition regions' = CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[transition_zone] = TRUE())
            formatString: "0"
            displayFolder: "Fuzzy"

        measure 'Fuzzy transition share' = DIVIDE(CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[transition_zone] = TRUE()), DISTINCTCOUNT('Fact_Region'[region_id]))
            formatString: "0.0%"
            displayFolder: "Fuzzy"

        measure 'Converging regions' = CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[converged_toward_destination] = TRUE())
            formatString: "0"
            displayFolder: "Convergence"

        measure 'Converging share' = DIVIDE(CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[converged_toward_destination] = TRUE()), DISTINCTCOUNT('Fact_Region'[region_id]))
            formatString: "0.0%"
            displayFolder: "Convergence"

        measure 'Mean max membership' = AVERAGE('Fact_Region'[max_membership])
            formatString: "0.000"
            displayFolder: "Fuzzy"

        measure 'Mean membership margin' = AVERAGE('Fact_Region'[membership_margin])
            formatString: "0.000"
            displayFolder: "Fuzzy"

        measure 'Mean convergence index' = AVERAGE('Fact_Region'[convergence_index])
            formatString: "0.0000"
            displayFolder: "Convergence"

        measure 'Median convergence index' = MEDIAN('Fact_Region'[convergence_index])
            formatString: "0.0000"
            displayFolder: "Convergence"

        measure 'Selected median contribution' = MAX('Conv_Indicator'[median_contribution])
            formatString: "0.0000"
            displayFolder: "Convergence contribution"

        measure 'Selected mean contribution' = MAX('Conv_Indicator'[mean_contribution])
            formatString: "0.0000"
            displayFolder: "Convergence contribution"

        measure 'Selected consistency pct' = MAX('Conv_Indicator'[consistency_pct])
            formatString: "0.0"
            displayFolder: "Convergence contribution"

        measure 'Selected flow converging regions' = MAX('Conv_Flow'[regions_converging_toward_destination])
            formatString: "0"
            displayFolder: "Convergence"

        measure 'Selected flow converging share' = MAX('Conv_Flow'[share_converging_toward_destination])
            formatString: "0.0%"
            displayFolder: "Convergence"

        measure 'Own-country nearest regions' = CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[nearest_reference_is_own_country] = TRUE())
            formatString: "0"
            displayFolder: "Country reference"