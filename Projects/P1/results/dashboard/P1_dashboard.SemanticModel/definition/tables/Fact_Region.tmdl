		lineageTag: 9ed816ce-1d39-4664-b2dc-614665b5c6e4

	measure 'Own-country nearest regions' = CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[nearest_reference_is_own_country] = TRUE())
		formatString: 0
		displayFolder: Country reference
		lineageTag: 5c8a375b-021a-4050-9a48-d2b21ae08e16

	measure 'C1 regions (clear)' = CALCULATE ( [Regions], KEEPFILTERS ( Dim_Region[display_class] = "C1" ) ) + 0
		formatString: 0
		displayFolder: Dashboard\Composition
		lineageTag: 522ee54a-0a8d-5486-a83b-3658d46fc141

	measure 'C2 regions (clear)' = CALCULATE ( [Regions], KEEPFILTERS ( Dim_Region[display_class] = "C2" ) ) + 0
		formatString: 0
		displayFolder: Dashboard\Composition
		lineageTag: 5de4328b-da65-5372-ab5b-16cef1b32b58

	measure 'Transition regions (display)' = CALCULATE ( [Regions], KEEPFILTERS ( Dim_Region[display_class] = "Transition" ) ) + 0
		formatString: 0
		displayFolder: Dashboard\Composition
		lineageTag: 43a87997-0722-5ad1-a789-838f67737d50

	measure 'Share assigned to C1' = DIVIDE ( CALCULATE ( [Regions], KEEPFILTERS ( Fact_Region[hard_cluster] = 1 ) ), [Regions] )
		formatString: 0%
		displayFolder: Dashboard\Composition
		lineageTag: 253f7718-cf0f-5433-9d22-4fc699e7df3d

	measure 'Profiles present' = CALCULATE ( DISTINCTCOUNT ( Fact_Region[hard_cluster] ) )
		formatString: 0
		displayFolder: Dashboard\Composition
		lineageTag: 7aad3f08-3e7a-5dfd-a18a-b3ec373e3e70

	measure 'Map colour' =
			SWITCH (
			    SELECTEDVALUE ( Dim_Region[display_class] ),
			    "C1", "#2F6690",
			    "C2", "#D39B2A",
			    "Transition", "#8E2C48",
			    "#D5DCE3"
			)
		displayFolder: Dashboard\Formatting
		lineageTag: b6c7e720-72c2-5ea9-a1ca-704e4ee87dea

	measure 'Scope label' =
			VAR n = FORMAT ( [Regions], "0" )
			RETURN
			    IF (
			        HASONEVALUE ( Dim_Country[country_name] ),
			        SELECTEDVALUE ( Dim_Country[country_name] ) & " · " & n & " regions",
			        "All countries · " & n & " regions"
			    )
		displayFolder: Dashboard\Text
		lineageTag: c4d78d2d-33f9-5a6f-8482-f2f5744c2d18

	measure 'Selected region title' =
			IF (
			    HASONEVALUE ( Dim_Region[region_id] ),
			    SELECTEDVALUE ( Dim_Region[region_label] ) & " · " & SELECTEDVALUE ( Dim_Region[country_name] ),
			    "Selected region · click a region on the map"
			)
		displayFolder: Dashboard\Text
		lineageTag: 0582938a-747b-552d-b539-1d34a3de44ce

	measure 'Selected region profile' =
			IF (
			    HASONEVALUE ( Dim_Region[region_id] ),
			    VAR cls = SELECTEDVALUE ( Dim_Region[display_class] )
			    VAR hc = SELECTEDVALUE ( Fact_Region[hard_cluster] )
			    RETURN
			        IF (
			            cls = "Transition",
			            "C" & hc & " (TZ)",
			            cls
			        ),
			    "—"
			)
		displayFolder: Dashboard\Text
		lineageTag: d155536c-acfc-5298-b4e8-93951774b542

	measure 'Selected region closest country' =
			
			IF (
			    HASONEVALUE ( Dim_Region[region_id] ),
			
			    VAR nearest_code =
			        SELECTEDVALUE ( Fact_Region[nearest_reference_country_code] )
			
			    VAR nearest_country =
			        LOOKUPVALUE (
			            Dim_Country[country_name],
			            Dim_Country[code],
			            nearest_code
			        )
			
			    RETURN
			        COALESCE ( nearest_country, "—" ),
			
			    "—"
			)
		displayFolder: Dashboard\Text
		lineageTag: 4c230dbe-f7f6-5a37-b118-85014f30f530

	measure 'Selected region own country rank' =
			
			IF (
			    HASONEVALUE ( Dim_Region[region_id] ),
			
			    VAR rk =
			        SELECTEDVALUE ( Fact_Region[own_country_rank] )
			
			    RETURN
			        IF (
			            NOT ISBLANK ( rk ),
			            "#" & FORMAT ( rk, "0" ),
			            "—"
			        ),
			
			    "—"
			)
		displayFolder: Dashboard\Text
		lineageTag: 8c266a86-76b0-564c-82e0-6efacd30f33e

	measure 'Membership C1' = AVERAGE ( Fact_Region[u_cluster_1] )
		formatString: 0%
		displayFolder: Dashboard\Membership
		lineageTag: 83c8c1fd-8670-5375-a847-8c9a3887722a

	measure 'Membership C2' = AVERAGE ( Fact_Region[u_cluster_2] )
		formatString: 0%
		displayFolder: Dashboard\Membership
		lineageTag: 9be33e1a-1036-5e9d-8432-c5b2b08035ea

	measure 'Membership title' =
			IF (
			    HASONEVALUE ( Dim_Region[region_id] ),
			    "Degree of association · " & SELECTEDVALUE ( Dim_Region[region_label] ),
			    "Degree of association · average of " & FORMAT ( [Regions], "0" ) & " regions"
			)
		displayFolder: Dashboard\Text
		lineageTag: d8145e5c-661d-5086-864b-871e1e8ea6c6

	measure 'Profile medoid' =
			VAR code = SELECTEDVALUE ( Dim_Cluster[medoid_country_code] )
			RETURN SELECTEDVALUE ( Dim_Cluster[medoid_geo_name] ) & ", " & LOOKUPVALUE ( Dim_Country[country_name], Dim_Country[code], code )
		displayFolder: Dashboard\Profiles
		lineageTag: aa40cfad-74d2-58b3-8228-e224e49f7710

	measure 'Profile medoid caption' = "Representative region (medoid): " & [Profile medoid]
		displayFolder: Dashboard\Profiles
		lineageTag: 52ab4cca-1968-5ed7-9655-0d3f62128c16

	measure 'Profile regions assigned' = SUM ( Fact_Cluster[hard_cluster_size] )
		formatString: 0
		displayFolder: Dashboard\Profiles
		lineageTag: 47fb6e6b-ac0e-58a4-b69a-88d95c86a948

	measure 'Profile effective size' = SUM ( Fact_Cluster[effective_fuzzy_size] )
		formatString: 0.0
		displayFolder: Dashboard\Profiles
		lineageTag: d2edb405-9e31-52aa-96ff-81b0a7274b23

	measure 'Profile transition regions' = SUM ( Fact_Cluster[fuzzy_transition_regions] )
		formatString: 0
