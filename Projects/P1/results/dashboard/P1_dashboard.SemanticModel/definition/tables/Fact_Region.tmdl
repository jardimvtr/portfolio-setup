	measure 'Standardized difference' = AVERAGE ( Feature_Profile[standardized_difference_from_pooled_mean] )
		formatString: 0.00
		displayFolder: Dashboard\Profiles
		lineageTag: e0f725d3-9fd6-51a9-9365-85a98bd7de19

	measure 'Typical value (weighted median)' = AVERAGE ( Feature_Annual[weighted_median] )
		formatString: 0.000
		displayFolder: Dashboard\Profiles
		lineageTag: 3496991e-d0ee-5161-a7c1-d298f207cb94

	measure 'Indicator weight' = CALCULATE ( SUM ( Dim_Indicator[common_weight] ), TREATAS ( VALUES ( Dim_Feature[feature] ), Dim_Indicator[feature] ) )
		formatString: 0.00
		displayFolder: Dashboard\Profiles
		lineageTag: 1a4c74ea-02e8-5313-980a-297498249fed

	measure 'Indicator typical C1' = CALCULATE ( AVERAGE ( Indicator_Profile[profile_median] ), REMOVEFILTERS ( Dim_Cluster ), Indicator_Profile[cluster] = 1, TREATAS ( VALUES ( Dim_Feature[feature] ), Dim_Indicator[feature] ) )
		formatString: 0.000
		displayFolder: Dashboard\Profiles
		lineageTag: 69345af0-2631-561a-b7a8-0d91bf329332

	measure 'Indicator typical C2' = CALCULATE ( AVERAGE ( Indicator_Profile[profile_median] ), REMOVEFILTERS ( Dim_Cluster ), Indicator_Profile[cluster] = 2, TREATAS ( VALUES ( Dim_Feature[feature] ), Dim_Indicator[feature] ) )
		formatString: 0.000
		displayFolder: Dashboard\Profiles
		lineageTag: 1f78f6c0-db2c-54df-9611-3d296d7d9f08

	measure 'C1 typical value' = CALCULATE ( AVERAGE ( Feature_Profile[weighted_median_2015_2019] ), REMOVEFILTERS ( Dim_Cluster ), Feature_Profile[cluster] = 1 )
		formatString: 0.000
		displayFolder: Dashboard\Profiles
		lineageTag: 5f5f94f0-19d0-5e0c-a01e-2b63372ad257

	measure 'C2 typical value' = CALCULATE ( AVERAGE ( Feature_Profile[weighted_median_2015_2019] ), REMOVEFILTERS ( Dim_Cluster ), Feature_Profile[cluster] = 2 )
		formatString: 0.000
		displayFolder: Dashboard\Profiles
		lineageTag: d57dda43-114f-5106-99ac-d7a6b53558ae

	measure 'Region value 2015-2019 mean' = AVERAGE ( Region_Year_Feature[feature_value] )
		formatString: 0.000
		displayFolder: Dashboard\Profiles
		lineageTag: 86d970f0-540f-5990-9612-8b3ef1e88032

	measure 'Moved away' = CALCULATE ( [Regions], KEEPFILTERS ( Fact_Region[moved_away_from_destination] = TRUE () ) ) + 0
		formatString: 0
		displayFolder: Dashboard\Trajectories
		lineageTag: 579c419f-f21f-54a9-bac3-f1ca262140e7

	measure 'Formal profile changes' = CALCULATE ( [Regions], KEEPFILTERS ( Fact_Region[formal_cluster_change_2015_2019] = TRUE () ) ) + 0
		formatString: 0
		displayFolder: Dashboard\Trajectories
		lineageTag: 9a42b880-202a-531c-a7c1-83c334f0639f

	measure 'Median relative position' = MEDIAN ( Region_Year_Distance[relative_destination_origin_gap] )
		formatString: 0.000
		displayFolder: Dashboard\Trajectories
		lineageTag: 5bfa7da0-5eb7-5267-a74d-aa1e3639171b

	measure 'Median distance to own profile' = MEDIAN ( Region_Year_Distance[annual_distance_to_origin_medoid] )
		formatString: 0.0000
		displayFolder: Dashboard\Trajectories
		lineageTag: f40121c1-7fba-5a6b-bca6-04ef2f601614

	measure 'Median distance to alternative profile' = MEDIAN ( Region_Year_Distance[annual_distance_to_destination_medoid] )
		formatString: 0.0000
		displayFolder: Dashboard\Trajectories
		lineageTag: 9e625749-c282-5088-913b-4d47752ecefe

	measure 'Indicator consistency' = DIVIDE ( AVERAGE ( Conv_Indicator[consistency_pct] ), 100 )
		formatString: 0%
		displayFolder: Dashboard\Trajectories
		lineageTag: 91f38b51-830b-54a0-9778-d35370c017a9

	measure 'Indicator median contribution' = AVERAGE ( Conv_Indicator[median_contribution] )
		formatString: 0.000
		displayFolder: Dashboard\Trajectories
		lineageTag: d1ae33d3-4283-5773-9dce-42d0d9e763f3

	measure 'Countries with both profiles' = COUNTROWS ( FILTER ( VALUES ( Dim_Country[code] ), [Profiles present] = 2 ) ) + 0
		formatString: 0
		displayFolder: Dashboard\Country context
		lineageTag: e350af22-8c45-53ac-af64-351853c95db2

	measure 'Viable local models' = CALCULATE ( COUNTROWS ( Global_Local_Country ), KEEPFILTERS ( Global_Local_Country[country_model_status] = "SUCCESS" ) ) + 0
		formatString: 0
		displayFolder: Dashboard\Country context
		lineageTag: 32fb828e-39b4-5ccd-b561-39368e8ab5e2

	measure 'Own-country closest share' = DIVIDE ( [Own-country nearest regions], [Regions] )
		formatString: 0%
		displayFolder: Dashboard\Country context
		lineageTag: fed0cd0f-a355-56bd-a161-7cfa4579d829

	measure 'Local model (display)' =
			SWITCH (
			    SELECTEDVALUE ( Global_Local_Country[country_model_status] ),
			    "SUCCESS", SELECTEDVALUE ( Global_Local_Country[country_selected_c] ) & " local groups",
			    "SKIPPED_TOO_SMALL", "Not estimated · too few regions",
			    "SKIPPED_NO_VIABLE_PARTITION", "No viable partition",
			    BLANK ()
			)
		displayFolder: Dashboard\Country context
		lineageTag: 35ead536-e0c0-54fa-818c-c808455e3b0a

	measure 'Agreement (display)' =
			VAR ok = SELECTEDVALUE ( Global_Local_Country[country_model_status] ) = "SUCCESS"
			VAR ari = AVERAGE ( Global_Local_Country[ari_global_vs_local] )
			RETURN
			    SWITCH (
			        TRUE (),
			        NOT HASONEVALUE ( Dim_Country[code] ), BLANK (),
			        NOT ok, "—",
			        [Profiles present] = 1, "n/a · single global profile",
			        "ARI " & FORMAT ( ari, "0.00", "en-US" )
			    )
		displayFolder: Dashboard\Country context
		lineageTag: 6372a786-aa9a-5ecd-be17-31c411a19962

	measure 'Median distance to reference' = MEDIAN ( Region_Country_Ref[mean_annual_distance_2015_2019] )
		formatString: 0.0000
		displayFolder: Dashboard\Country context
		lineageTag: 579b39ef-0a56-5a12-9f29-47f3aaeb140f

	measure 'Closest references (top 10)' =
			VAR d = [Median distance to reference]
			VAR rk =
			    RANKX (
			        ALLSELECTED ( Dim_Ref_Country[reference_country_name] ),
			        [Median distance to reference],
			        ,
			        ASC,
			        Dense
			    )
			RETURN IF ( NOT ISBLANK ( d ) && rk <= 10, d )
		formatString: 0.0000
		displayFolder: Dashboard\Country context
		lineageTag: 5a3aea29-78d5-5d69-9fc2-ebaa4b3c4873

	measure 'Reference bar colour' =
			VAR ownRows = CALCULATE ( COUNTROWS ( Region_Country_Ref ), KEEPFILTERS ( Region_Country_Ref[is_own_country_reference] = TRUE () ) )
			VAR focused = HASONEVALUE ( Dim_Country[code] ) || HASONEVALUE ( Dim_Region[region_id] )
			RETURN IF ( focused && ownRows > 0, "#14212E", "#AAB6C2" )
		displayFolder: Dashboard\Formatting
		lineageTag: 0b8ca769-e0d6-5d96-95e3-204a38a4d7b5

	measure 'Reference chart title' =
			
			SWITCH (
			    TRUE (),
			    HASONEVALUE ( Dim_Region[region_id] ), "Closest country references · " & SELECTEDVALUE ( Dim_Region[region_label] ),
			    HASONEVALUE ( Dim_Country[code] ), "Which countries do regions of " & SELECTEDVALUE ( Dim_Country[country_name] ) & " most resemble?",
			    "Closest references"
			)
		displayFolder: Dashboard\Text
		lineageTag: 9e4a755f-7a5f-59d8-98ef-51358c4be7e4

	measure 'Profile mix bar (SVG)' =
			VAR n = [Regions]
			VAR w1 = INT ( DIVIDE ( [C1 regions (clear)], n ) * 1000 )
			VAR wt = INT ( DIVIDE ( [Transition regions (display)], n ) * 1000 )
			VAR w2 = INT ( DIVIDE ( [C2 regions (clear)], n ) * 1000 )
			RETURN
			    IF (
			        n > 0,
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1000 100' preserveAspectRatio='none'>"
			            & "<rect x='0' y='20' width='1000' height='60' fill='%23EEF2F6'/>"
			            & "<rect x='0' y='20' width='" & w1 & "' height='60' fill='%232F6690'/>"
			            & "<rect x='" & w1 & "' y='20' width='" & wt & "' height='60' fill='%238E2C48'/>"
			            & "<rect x='" & ( w1 + wt ) & "' y='20' width='" & w2 & "' height='60' fill='%23D39B2A'/>"
			            & "</svg>"
			    )
		displayFolder: Dashboard\Formatting
		lineageTag: 9c122f7d-9d29-55a9-91ed-718e13591be3
		dataCategory: ImageUrl

