table Fact_Region
	lineageTag: 38755417-83eb-4cf3-a80d-e3fa1a3e297e

	measure Regions = DISTINCTCOUNT('Fact_Region'[region_id])
		formatString: 0
		displayFolder: Core
		lineageTag: 9cb3c7f4-3ed7-4b73-a326-033a6cf61a27

	measure Countries = DISTINCTCOUNT('Fact_Region'[code])
		formatString: 0
		displayFolder: Core
		lineageTag: b67cf425-0e8d-4376-94d7-d0fc25c82373

	measure 'Fuzzy transition regions' = CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[transition_zone] = TRUE())
		formatString: 0
		displayFolder: Fuzzy
		lineageTag: 892c3219-285b-4688-9930-cac0478e27aa

	measure 'Fuzzy transition share' = DIVIDE(CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[transition_zone] = TRUE()), DISTINCTCOUNT('Fact_Region'[region_id]))
		formatString: 0.0%
		displayFolder: Fuzzy
		lineageTag: 1f9b7f7b-a293-46cb-936a-4a71a1f9ac07

	measure 'Converging regions' = CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[converged_toward_destination] = TRUE())
		formatString: 0
		displayFolder: Convergence
		lineageTag: a401738f-df3d-47df-a2df-7dd11137e90c

	measure 'Converging share' = DIVIDE(CALCULATE(DISTINCTCOUNT('Fact_Region'[region_id]), 'Fact_Region'[converged_toward_destination] = TRUE()), DISTINCTCOUNT('Fact_Region'[region_id]))
		formatString: 0.0%
		displayFolder: Convergence
		lineageTag: c12fae80-4c65-4d8a-b5f7-7314575ecdaa

	measure 'Mean max membership' = AVERAGE('Fact_Region'[max_membership])
