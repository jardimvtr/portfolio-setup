model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

annotation PBI_QueryOrder = ["Dim_Year","Dim_Country","Dim_Ref_Country","Dim_Region","Dim_Cluster","Dim_Flow","Dim_Family","Dim_Feature","Dim_Indicator","Model_Summary","Fact_Region","Fact_Cluster","Feature_Profile","Feature_Annual","Indicator_Profile","Indicator_Annual","Region_Year_Feature","Region_Year_Indicator","Fuzzy_Summary","Conv_Flow","Conv_Feature","Conv_Family","Conv_Indicator","Global_Local_Country","Global_Local_Region","Country_Ref_Region","Conv_Reg_Indicator","Conv_Reg_Ind_Annual","Region_Year_Distance","Region_Country_Ref"]

ref table Dim_Year
ref table Dim_Country
ref table Dim_Ref_Country
ref table Dim_Region
ref table Dim_Cluster
ref table Dim_Flow
ref table Dim_Family
ref table Dim_Feature
ref table Dim_Indicator
ref table Model_Summary
ref table Fact_Region
ref table Fact_Cluster
ref table Feature_Profile
ref table Feature_Annual
ref table Indicator_Profile
ref table Indicator_Annual
ref table Region_Year_Feature
ref table Region_Year_Indicator
ref table Fuzzy_Summary
ref table Conv_Flow
ref table Conv_Feature
ref table Conv_Family
ref table Conv_Indicator
ref table Global_Local_Country
ref table Global_Local_Region
ref table Country_Ref_Region
ref table Conv_Reg_Indicator
ref table Conv_Reg_Ind_Annual
ref table Region_Year_Distance
ref table Region_Country_Ref

ref cultureInfo pt-BR

