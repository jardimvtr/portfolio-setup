        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "text": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#4A5A6A"
              }
            }
          },
          {
            "$id": "hover",
            "fontColor": {
              "solid": {
                "color": "#14212E"
