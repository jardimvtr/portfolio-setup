        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2632"
              }
            },
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "gridVertical": false,
            "rowPadding": 3,
            "textSize": 9
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#5C6B7A"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2632"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2.5,
            "lineChartType": "linear",
            "showMarker": true,
            "markerSize": 4
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "$id": "default",
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 20,
            "fontColor": {
              "solid": {
                "color": "#1B2632"
              }
            }
          }
        ],
        "label": [
          {
            "$id": "default",
            "position": "aboveValue",
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#5C6B7A"
              }
            }
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ]
      }
    }
