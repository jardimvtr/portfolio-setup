              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "rectangleRounded",
            "roundEdge": 6
          }
        ]
      }
